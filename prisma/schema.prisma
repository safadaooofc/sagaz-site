generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  discordId     String?
  telegramId    String?
  balance       Float           @default(0.0)
  role          String          @default("USER")
  resellerDiscount Float        @default(0.0)
  referralCode  String?         @unique
  referredById  String?
  referralDiscount Float        @default(0.0)
  referralRewardGiven Boolean   @default(false)
  tokenVersion  Int             @default(1)
  adminStatus   String          @default("OFFLINE")
  adminLastActive DateTime?
  twoFactorMethod String        @default("EMAIL") // NONE, EMAIL, APP
  twoFactorSecret String?
  resetPasswordToken String?
  resetPasswordExpires DateTime?
  
  accounts      Account[]
  sessions      Session[]
  deviceSessions DeviceSession[]
  transactions  Transaction[]
  balanceLogs   BalanceMovement[]
  reviews       Review[]
  notifications Notification[]
  adminLogs     AdminLog[]
  withdrawals   Withdrawal[]
  rewardCodesCreated RewardCode[]
  rewardUsages  RewardUsageLog[]
  
  referredBy    User?           @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]          @relation("Referrals")
  dropEventClaims DropEventClaim[]
  recharges     Recharge[]
  minesGames    MinesGame[]
  tickets       Ticket[]
  ticketMessages TicketMessage[]
  exchangeRequests ExchangeRequest[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model RateLimit {
  key       String   @id
  points    Int      @default(0)
  expire    DateTime
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String?
  name        String
  description String?
  price       Float
  stock       Int           @default(0)
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
  stockItems   StockItem[]
  reviews      Review[]
  drops        DropCode[]
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  total     Float
  status    String   @default("COMPLETED")
  date      DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  stockItems StockItem[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Float?
  discountFixed   Float?
  maxUses         Int      @default(0)
  used            Int      @default(0)
  active          Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
}

model StockItem {
  id            String   @id @default(cuid())
  productId     String
  content       String   @db.Text
  isDelivered   Boolean  @default(false)
  transactionId String?
  createdAt     DateTime @default(now())

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model SystemConfig {
  key   String @id
  value String @db.Text
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  ip           String
  browser      String
  os           String
  tokenVersion Int
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id        String   @id @default(cuid())
  ip        String
  event     String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

model BalanceMovement {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GiftCode {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    Float
  maxUses   Int      @default(1)
  used      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DropCode {
  id        String   @id @default(cuid())
  code      String   @unique
  productId String
  maxUses   Int      @default(1)
  used      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PendingDiscordReward {
  discordId      String   @id
  pendingBalance Float    @default(0.0)
  invitesCount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recharge {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  bonus       Float    @default(0.0)
  totalAmount Float    @default(0.0)
  method      String
  currency    String?
  status      String   @default("pending")
  externalId  String?
  pixCode     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DropEvent {
  id             String    @id @default(cuid())
  title          String
  description    String?
  targetAudience String    @default("todos")
  hasPassword    Boolean   @default(false)
  password       String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  cards          DropEventCard[]
  claims         DropEventClaim[]
}

model DropEventCard {
  id          String    @id @default(cuid())
  dropEventId String
  content     String    @db.Text
  createdAt   DateTime  @default(now())

  dropEvent   DropEvent @relation(fields: [dropEventId], references: [id], onDelete: Cascade)
}

model DropEventClaim {
  id          String    @id @default(cuid())
  dropEventId String
  userId      String
  createdAt   DateTime  @default(now())

  dropEvent   DropEvent @relation(fields: [dropEventId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dropEventId, userId])
}


model AdminLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  pixKey    String
  pixType   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model RewardCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String
  value       Float?
  productId   String?
  maxUses     Int      @default(1)
  used        Int      @default(0)
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy   User?    @relation(fields: [createdById], references: [id])
  usages      RewardUsageLog[]
}

model RewardUsageLog {
  id           String     @id @default(cuid())
  rewardCodeId String
  userId       String
  createdAt    DateTime   @default(now())

  rewardCode   RewardCode @relation(fields: [rewardCodeId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MinesGame {
  id          String   @id @default(cuid())
  userId      String
  betAmount   Float
  multiplier  Float    @default(1.0)
  bombsCount  Int
  boardData   String   @db.Text
  status      String   @default("PLAYING") // PLAYING, CASHOUT, BUST
  profit      Float    @default(0.0)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ticket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  senderId    String
  content     String   @db.Text
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())

  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model ExchangeRequest {
  id           String   @id @default(cuid())
  userId       String
  giftCardCode String
  requestedValue Float
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
