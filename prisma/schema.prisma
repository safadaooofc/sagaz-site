generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  discordId     String?
  telegramId    String?
  balance       Float           @default(0.0)
  role          String          @default("USER")
  resellerDiscount Float        @default(0.0)
  referralCode  String?         @unique
  referredById  String?
  referralDiscount Float        @default(0.0)
  referralRewardGiven Boolean   @default(false)
  tokenVersion  Int             @default(1)
  
  accounts      Account[]
  sessions      Session[]
  deviceSessions DeviceSession[]
  transactions  Transaction[]
  balanceLogs   BalanceMovement[]
  reviews       Review[]
  
  referredBy    User?           @relation("Referrals", fields: [referredById], references: [id])
  referredUsers User[]          @relation("Referrals")

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model RateLimit {
  key       String   @id
  points    Int      @default(0)
  expire    DateTime
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String?
  name        String
  description String?
  price       Float
  stock       Int           @default(0)
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category    Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]
  stockItems   StockItem[]
  reviews      Review[]
  drops        DropCode[]
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  total     Float
  status    String   @default("COMPLETED")
  date      DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  stockItems StockItem[]
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountPercent Float?
  discountFixed   Float?
  maxUses         Int      @default(0)
  used            Int      @default(0)
  active          Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
}

model StockItem {
  id            String   @id @default(cuid())
  productId     String
  content       String   @db.Text
  isDelivered   Boolean  @default(false)
  transactionId String?
  createdAt     DateTime @default(now())

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
}

model SystemConfig {
  key   String @id
  value String @db.Text
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DeviceSession {
  id           String   @id @default(cuid())
  userId       String
  ip           String
  browser      String
  os           String
  tokenVersion Int
  lastSeen     DateTime @default(now())
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SecurityLog {
  id        String   @id @default(cuid())
  ip        String
  event     String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

model BalanceMovement {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GiftCode {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    Float
  maxUses   Int      @default(1)
  used      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DropCode {
  id        String   @id @default(cuid())
  code      String   @unique
  productId String
  maxUses   Int      @default(1)
  used      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}
